# Copy this file to .env and fill in your own values, then run: docker compose up -d
# .env is read automatically by Docker Compose and is git-ignored.

# Admin token — the master credential for the hub. Generate a strong one:
#   openssl rand -hex 24
PROMAG_SERVER_TOKEN=replace-with-a-long-random-token

# Public base URL teammates reach the hub at. Used in the connection strings
# you share with users. Use your real HTTPS host in production.
PROMAG_PUBLIC_URL=https://promag.example.com
